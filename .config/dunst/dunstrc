[global]
    # ========== MONITOR & GEOMETRY ==========
    follow = mouse
    monitor = 0
    origin = bottom-right
    offset = 40x60
    width = 340
    height = 400
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # ========== APPEARANCE & THEMING ==========
    font = JetBrains Mono 10
    line_height = 0
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    separator_height = 2
    frame_color = "#393939"
    separator_color = "#393939"

    # ========== COLORS - DARK THEME ==========
    # background = "#1E1E2E"
    background = "#b6f505"
    foreground = "#CDD6F4"
    highlight = "#CBA6F7"

    # ========== TIMEOUTS & BEHAVIOR ==========
    timeout = 8
    ignore_dbusclose = false
    show_indicators = true
    word_wrap = true
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    sticky_history = true
    history_length = 20
    always_run_script = true
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_path = "/usr/share/icons/Papirus-Dark/16x16/apps/:/usr/share/icons/Papirus-Dark/22x22/apps/:/usr/share/icons/Papirus-Dark/24x24/apps/:/usr/share/icons/Papirus-Dark/32x32/apps/:/usr/share/icons/Papirus-Dark/48x48/apps/:/usr/share/icons/hicolor/48x48/apps/"

    # ========== CORNERS & ROUNDING ==========
    corner_radius = 12
    force_xwayland = false

    # ========== MOUSE INTERACTION ==========
    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#b6f505"
    foreground = "#0000FF"
    frame_color = "#000000"
    timeout = 6

[urgency_normal]
    background = "#b6f505"
    foreground = "#0000FF"
    frame_color = "#000000"
    timeout = 8
    highlight = "#89B4FA"

[urgency_critical]
    background = "#b6f505"
    foreground = "#CDD6F4"
    frame_color = "#000000"
    timeout = 0
    highlight = "#F38BA8"

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

# ========== APPLICATION-SPECIFIC RULES ==========
[discord]
    appname = discord
    background = "#1E1E2E"
    frame_color = "#5865F2"
    highlight = "#5865F2"
    timeout = 10

[spotify]
    appname = spotify
    background = "#1E1E2E"
    frame_color = "#1DB954"
    highlight = "#1DB954"
    timeout = 5

[telegram]
    appname = telegram
    background = "#1E1E2E"
    frame_color = "#0088CC"
    highlight = "#0088CC"
    timeout = 10

[email]
    appname = thunderbird
    background = "#1E1E2E"
    frame_color = "#0A84FF"
    highlight = "#0A84FF"
    timeout = 10

